# Non-secret local defaults. Copy to .env only for local development.
GATEWAY_PORT=8080
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
DEV_LOGS=true
LOG_LEVEL=INFO
MUTE_LOGGERS=uvicorn.access
AUTH_COOKIE_SECURE=false

IDENTITY_POSTGRES_USER=andruha_identity
IDENTITY_POSTGRES_PASSWORD=identity-local-only
IDENTITY_POSTGRES_DB=andruha_identity

PROFILE_POSTGRES_USER=andruha_profile
PROFILE_POSTGRES_PASSWORD=profile-local-only
PROFILE_POSTGRES_DB=andruha_profile
PROFILE_PROVISIONING_TOKEN=profile-provisioning-local-only
PROFILE_SERVICE_TIMEOUT_SECONDS=3
PROFILE_SERVICE_RETRY_DELAY_SECONDS=0.1
PROFILE_SERVICE_RETRY_MAX_DELAY_SECONDS=1
PROFILE_SERVICE_CB_FAILURES=5
PROFILE_SERVICE_CB_RECOVERY_SECONDS=30
REGISTRATION_POLL_INTERVAL_SECONDS=2
REGISTRATION_BATCH_SIZE=25
REGISTRATION_CLAIM_LEASE_SECONDS=30
REGISTRATION_RETRY_INITIAL_SECONDS=1
REGISTRATION_RETRY_MAX_SECONDS=60
REGISTRATION_RETRY_EXPONENT=2
REGISTRATION_RETRY_JITTER_RATIO=0.2
REGISTRATION_RETRY_MAX_ATTEMPTS=10
REGISTRATION_SHUTDOWN_TIMEOUT_SECONDS=30

OBJECT_STORAGE_POSTGRES_USER=andruha_object_storage
OBJECT_STORAGE_POSTGRES_PASSWORD=object-storage-local-only
OBJECT_STORAGE_POSTGRES_DB=andruha_object_storage

KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
MINIO_ROOT_USER=andruha-local
ANDRUHA_NETWORK_NAME=andruha-local
MINIO_ROOT_PASSWORD=minio-local-only
